{
    email {$LETSENCRYPT_EMAIL:admin@luminaview.fr}
    on_demand_tls {
        ask http://127.0.0.1:5555/check
    }
}

# Point de contrôle de sécurité On-Demand TLS :
# Bloque les attaques de robots / sous-domaines fantômes pour éviter l'épuisement des quotas Let's Encrypt et du CPU
:5555 {
    @allowed {
        query domain=luminaview.fr
        query domain=www.luminaview.fr
        query domain=helioscope.fr
        query domain=www.helioscope.fr
    }
    @subdomain {
        expression `{query.domain}.matches(r"^[a-zA-Z0-9_-]{2,40}\.helioscope\.fr$")`
    }

    handle @allowed {
        respond 200
    }
    handle @subdomain {
        respond 200
    }
    handle {
        respond 403
    }
}

# -------------------------------------------------------------
# 1. STUDIO MANAGER (luminaview.fr - Administration Privée)
# -------------------------------------------------------------
luminaview.fr, www.luminaview.fr {
    encode zstd gzip

    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header /uploads/* Cache-Control "public, max-age=86400"

    # API Express Backend & Fichiers Uploads (conserve le préfixe /api et /uploads)
    handle /api/* {
        reverse_proxy luminaview-backend:3000
    }
    handle /uploads/* {
        reverse_proxy luminaview-backend:3000
    }

    # Frontend Studio Manager
    handle {
        reverse_proxy luminaview-manager:80
    }
}

# -------------------------------------------------------------
# 2. ECOSYSTÈME PUBLIC MULTI-UTILISATEURS DYNAMIQUE (*.helioscope.fr)
# -------------------------------------------------------------
https:// {
    tls {
        on_demand
    }

    encode zstd gzip

    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header /uploads/* Cache-Control "public, max-age=86400"

    # API & Uploads pour tout l'écosystème
    handle /api/* {
        reverse_proxy luminaview-backend:3000
    }
    handle /uploads/* {
        reverse_proxy luminaview-backend:3000
    }

    # Sous-domaine spécifique pour le BLOG
    @blog header_regexp Host ^([a-zA-Z0-9-]+)-blog\.helioscope\.fr$
    handle @blog {
        reverse_proxy luminaview-blog:80
    }

    # Sous-domaine spécifique pour le CARNET
    @carnet header_regexp Host ^([a-zA-Z0-9-]+)-carnet\.helioscope\.fr$
    handle @carnet {
        reverse_proxy luminaview-chambrenoire:80
    }

    # Sous-domaine spécifique pour GRIMOIRE
    @grimoire header_regexp Host ^([a-zA-Z0-9-]+)-grimoire\.helioscope\.fr$
    handle @grimoire {
        reverse_proxy luminaview-grimoire:80
    }

    # Par défaut : Portfolio (*.helioscope.fr ou helioscope.fr)
    @helioscope host *.helioscope.fr helioscope.fr
    handle @helioscope {
        reverse_proxy luminaview-portfolio:80
    }
}
